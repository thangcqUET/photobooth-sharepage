# Production environment for photobooth-sharepage
# Set the allowed media hosts (comma-separated).
# Example:
# VITE_ALLOWED_MEDIA_HOSTS=media.example.com,cdn.example.com
# NOTE: Using '*' is NOT recommended for production.
VITE_ALLOWED_MEDIA_HOSTS=*
# VITE_ALLOWED_MEDIA_HOSTS=d1871y534fxymp.cloudfront.net

# When true, user must follow one of the social channels before download/share is enabled.
# Recommended: true in production.
VITE_REQUIRE_FOLLOW=false
